# Smart Ring Plus (VIEWE) known-good sdkconfig defaults
# See notes/esp-smartring.md section 6 for rationale.

# --- Flash size. The module is an ESP32-S3-N16R8 (16 MB flash); the IDF
#     default of 2 MB would reject the enlarged partition table.
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

# --- Console: send ALL output (including panic/WDT backtraces) to the
#     USB-Serial-JTAG port (/dev/ttyACM0). The primary console defaulted to
#     UART0 on GPIO43/44, which is NOT exposed on this board, so crashes were
#     invisible. Secondary console alone does not carry panic output.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
# CONFIG_ESP_CONSOLE_UART_DEFAULT is not set

# --- Required by the smartring_plus BSP ---
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_CODEC_I2C_BACKWARD_COMPATIBLE=n
CONFIG_LV_USE_CLIB_MALLOC=y

# Wi-Fi/LWIP buffers are large; with a UI also using PSRAM, allocate them
# from PSRAM instead of the tight internal heap. Only matters when an app
# actually calls ring_wifi_start().
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y

# The BSP's IMU sample task runs at 250 Hz (vTaskDelayUntil(pdMS_TO_TICKS(4))).
# At the default 100 Hz FreeRTOS tick that rounds to 0 -> xTaskDelayUntil assert.
# A 1 kHz tick is required (also standard for 48 kHz audio + 250 Hz IMU).
CONFIG_FREERTOS_HZ=1000

# --- Headroom for UI construction from app_main (launcher builds 37 label
#     objects in one call chain). 3584 is the IDF default; 8192 is comfortable.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# --- App partition. The Wi-Fi stack (esp_wifi + lwip + wpa_supplicant) and
#     esp_peer (WebRTC + DTLS + SRTP) push an app past the default 1 MB factory
#     partition, so the project carries a custom table (partitions.csv) with a
#     3000K app partition. Harmless for the smaller apps.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# --- WebRTC / HTTPS (examples/06_qianwenai_push_to_talk, ring_net)
#     DTLS-SRTP is required by esp_peer; it also disables
#     CONFIG_MBEDTLS_DYNAMIC_BUFFER, so keep the TLS buffers in PSRAM.
CONFIG_MBEDTLS_SSL_PROTO_DTLS=y
CONFIG_MBEDTLS_SSL_DTLS_SRTP=y
CONFIG_MBEDTLS_X509_CREATE_C=y
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
CONFIG_ESP_HTTP_CLIENT_ENABLE_HTTPS=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
# Some CAs (e.g. GlobalSign, used by baidu.com) serve a cross-signed root
# whose issuer is an older root that is not in the bundle. The default
# non-cross-signed path cannot build that chain; this makes esp-tls use the
# bundle's subject+key entries as synthetic trust anchors instead.
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_CROSS_SIGNED_VERIFY=y
# SNTP: allow multiple NTP servers (Aliyun + public pool) for clock sync.
CONFIG_LWIP_SNTP_MAX_SERVERS=3

# --- Bluetooth LE (NimBLE). Only pulled in when an app calls ring_bt_init();
#     the BT controller/host code is linked into every app but allocates no
#     RAM at runtime unless the host is started. NimBLE is the lightweight,
#     BLE-only host; ESP32-S3 has no Bluetooth Classic. See notes/bluetooth.md.
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
# CONFIG_BT_BLUEDROID_ENABLED is not set
CONFIG_BT_CONTROLLER_ENABLED=y
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=256
CONFIG_BT_NIMBLE_50_FEATURE_SUPPORT=y
# Persist bonding keys across reboots (needed for "pair once, reconnect".
CONFIG_BT_NIMBLE_NVS_PERSIST=y
CONFIG_BT_NIMBLE_MAX_BONDS=3

# --- LVGL 9 fonts. 20 is what the launcher icons use (LV_SYMBOL_* glyphs are
#     baked into the built-in Montserrat fonts). 14/16/24/48 kept for general use.
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_16=y
CONFIG_LV_FONT_MONTSERRAT_20=y   # launcher icon glyphs
CONFIG_LV_FONT_MONTSERRAT_24=y
CONFIG_LV_FONT_MONTSERRAT_48=y
